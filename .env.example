# Database
DATABASE_URL="postgresql://user:password@localhost:5432/lekeland?schema=public"

# App
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
BASE_URL="http://localhost:3000"

# Payment - Stripe (choose one payment provider)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Payment - Vipps (alternative to Stripe for Norway)
# VIPPS_CLIENT_ID=""
# VIPPS_CLIENT_SECRET=""
# VIPPS_SUBSCRIPTION_KEY=""
# VIPPS_MERCHANT_SERIAL=""

# Salto KS Access Control (via Seam API - recommended)
SEAM_API_KEY="seam_..."
SALTO_SYSTEM_ID="acs_system_..."
SALTO_ENTRANCE_ID="acs_entrance_..."

# Salto KS Direct API (alternative)
# SALTO_KS_API_KEY=""
# SALTO_KS_SITE_ID=""

# SMS - Twilio
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_PHONE_NUMBER="+47XXXXXXXX"

# SMS - Sveve (Norwegian alternative)
# SVEVE_USER=""
# SVEVE_PASSWORD=""

# Email - SendGrid
SENDGRID_API_KEY="SG..."
FROM_EMAIL="hei@lekeland.no"
FROM_NAME="Lekeland"

# Email - Alternative providers
# RESEND_API_KEY=""
# MAILGUN_API_KEY=""
# MAILGUN_DOMAIN=""

# Business Configuration
MAX_CAPACITY_PER_SLOT=15
BOOKING_ADVANCE_DAYS=14
CHILD_TICKET_PRICE=14900  # in øre (149 kr)
FACILITY_NAME="Lekeland"
EMERGENCY_PHONE="+47XXXXXXXX"
